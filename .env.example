# Copy to .env and fill in values. Never put secrets in NEXT_PUBLIC_* variables.

# App
APP_URL=http://localhost:3000
NODE_ENV=development
# Isolated demo: sample appointments, simulated payments, no real customer messages.
DEMO_MODE=true

# PostgreSQL
DATABASE_URL=postgresql://crowned:crowned_dev_local@127.0.0.1:5432/crowned

# Owner session (generate a long random string)
SESSION_SECRET=replace-with-a-long-random-secret

# Initial owner login (used by seed). Change after first login in production.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password
OWNER_NAME=Chrissy

# Demo owner (only created when DEMO_MODE=true)
DEMO_OWNER_EMAIL=chrissy@demo.crownedbychrissy.local
DEMO_OWNER_PASSWORD=demo-owner-pass

# Cron / job runner
CRON_SECRET=replace-with-a-random-cron-secret
JOBS_INTERVAL_MS=60000

# Cash N' Go / Paylanes — leave empty until merchant registration is complete.
# Do not copy sample AUTH_ID or API_KEY values from vendor documentation.
CNG_ENV=sandbox
CNG_AUTH_ID=
CNG_API_KEY=
# Must stay false until sandbox tests pass and live credentials are verified.
CNG_LIVE_ENABLED=false
# Optional: restrict checkout methods. PAYMENT_OPTIONS and PAYMENT_METHOD are mutually exclusive.
CNG_PAYMENT_OPTIONS=
CNG_PAYMENT_METHOD=
# Confirm settlement currency with Cash N' Go before production. Display currency is BSD (B$).
CNG_CURRENCY_CONFIRMED=false

# Notification providers — channels stay disabled until a provider is configured.
# Resend example (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Twilio example (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web Push for the owner PWA (optional). Generate VAPID keys before enabling.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Public site
NEXT_PUBLIC_APP_NAME=Crowned by Chrissy
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/12426462700
NEXT_PUBLIC_PHONE=+12426462700
